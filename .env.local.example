# ============================================================
#  Tudo — environment variables
#  Copy this file to  .env.local  and fill in the values.
#  .env.local is git-ignored — your secrets never get committed.
#  On Vercel, add these under Project → Settings → Environment Variables.
# ============================================================

# --- Google Sheet (your database) ---
# The long ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# --- Service account credentials (RECOMMENDED: base64) ---
# 1. Download the service-account JSON key from Google Cloud.
# 2. Turn it into one line:   base64 -w0 your-key.json
#    (on macOS:               base64 -i your-key.json | tr -d '\n')
# 3. Paste the output here:
GOOGLE_SERVICE_ACCOUNT_B64=

# --- OR, instead of the base64 var above, use these two ---
# GOOGLE_CLIENT_EMAIL=tudo-bot@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# --- Zoxo (Chrome extension) backend ---
# A SEPARATE spreadsheet, shared with the same tudo-bot service account.
# Run `npm run init-zoxo` once to build its tabs.
ZOXO_SHEET_ID=
# Shared key testers paste into the extension's settings. Generate with:
#   openssl rand -hex 24
# Leave empty only for local development — it leaves the ingest routes open.
ZOXO_INGEST_KEY=

# --- Session signing secret ---
# Generate one with:   openssl rand -base64 32
AUTH_SECRET=

# --- AI (OpenRouter — for the "Overall Update" summary) ---
OPENROUTER_API_KEY=

# --- Web push (VAPID) for phone notifications ---
# Generate a keypair with:   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@company.com
# Must equal VAPID_PUBLIC_KEY (exposed to the browser to subscribe):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Public site URL (optional) ---
# Used for absolute SEO / Open Graph URLs. Set to your deployed domain.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ============================================================
#  Only used by  `npm run init-sheet`  to create your first login.
#  You can delete these after the sheet is initialized.
# ============================================================
SEED_ADMIN_NAME=Tushar Mali
SEED_ADMIN_HANDLE=tushar
SEED_ADMIN_EMAIL=you@company.com
SEED_ADMIN_PASSWORD=change-me-now
